{
  "name": "spx-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "bump": "node scripts/sync.mjs --bump",
    "check": "npm run sync:check && npm run typecheck && npm test",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "ocr:fixture": "node scripts/ocr-fixture.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "^6.0.3"
  }
}
